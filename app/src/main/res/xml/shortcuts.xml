<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="change_server"
        android:shortcutShortLabel="@string/shortcut_change_server">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="io.github.novakr12.soundscape.SetupActivity"
            android:targetPackage="io.github.novakr12.soundscape" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="downloads"
        android:shortcutShortLabel="@string/shortcut_downloads">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="io.github.novakr12.soundscape.DownloadsActivity"
            android:targetPackage="io.github.novakr12.soundscape" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="settings"
        android:shortcutShortLabel="@string/shortcut_settings">
        <intent
            android:action="io.github.novakr12.soundscape.OPEN"
            android:targetClass="io.github.novakr12.soundscape.MainActivity"
            android:targetPackage="io.github.novakr12.soundscape">
            <extra
                android:name="page"
                android:value="/settings#this-app" />
        </intent>
    </shortcut>
</shortcuts>
